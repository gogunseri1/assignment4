# Base stage
FROM fedora:latest AS base

# Install httpd
RUN dnf install -y httpd && dnf clean all

# Expose port 80
EXPOSE 80

# Required entrypoint
ENTRYPOINT ["/usr/sbin/httpd", "-DFOREGROUND"]

# -------- Website 1 Image --------
FROM base AS website1
COPY website1.html /var/www/html/index.html
LABEL website="1"

# -------- Website 2 Image --------
FROM base AS website2
COPY website2.html /var/www/html/index.html
LABEL website="2"
	

